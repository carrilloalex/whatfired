{
  "manifest_version": 3,
  "name": "WhatFired: Analytics Event Tracker",
  "short_name": "WhatFired",
  "version": "1.0.12",
  "description": "Track analytics events live across Segment, GA4, Amplitude, Mixpanel and more. Inspect event names, properties and sources.",
  "minimum_chrome_version": "114",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "action": {
    "default_title": "Open WhatFired",
    "default_icon": {
      "16": "icons/action16.png",
      "24": "icons/action24.png",
      "32": "icons/action32.png"
    },
    "default_popup": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
